{
  "name": "geo-package-merger-code-review-branch",
  "version": "1.0.0",
  "description": "A tool for merging GeoPackage files with MapProxy integration",
  "main": "dist/merge.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/merge.js",
    "merge": "npm run build && node dist/merge.js",
    "dev": "tsc && node dist/merge.js",
    "clean": "rm -rf dist",
    "test": "jest"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "http-status-codes": "^2.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.1",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "geopackage",
    "merge",
    "sqlite",
    "gis",
    "mapproxy"
  ],
  "author": "",
  "license": "MIT"
}
